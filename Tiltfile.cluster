)

local_resource(
    'databricks-register',
    cmd=('{rewrite} && KROMC_KCP_KUBECONFIG={kc} KROMC_KCP_SERVER={sv} ' +
         'DATABRICKS_MANIFEST={mf} make install-provider-databricks').format(
             rewrite=DATABRICKS_REWRITE_CMD, kc=KCP_ADMIN_KUBECONFIG,
             sv=KCP_ADMIN_SERVER, mf=DATABRICKS_MANIFEST_REWRITTEN),
    trigger_mode=TRIGGER_MODE_MANUAL,
    auto_init=False,
    resource_deps=['kedge-hub'],
    labels=['providers-databricks'],
)

local_resource(
    'databricks-init',
    cmd=('KROMC_KCP_KUBECONFIG={kc} KROMC_KCP_SERVER={sv} ' +
         'make init-provider-databricks').format(
             kc=KCP_ADMIN_KUBECONFIG, sv=KCP_ADMIN_SERVER),
    trigger_mode=TRIGGER_MODE_MANUAL,
    auto_init=False,
    resource_deps=['kedge-hub', 'databricks-register'],
    labels=['providers-databricks'],
