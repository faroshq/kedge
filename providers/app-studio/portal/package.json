{
  "name": "kedge-provider-app-studio-portal",
  "version": "0.1.0",
  "private": true,
  "description": "App Studio provider portal bundle, shared with the projects provider UI source.",
  "type": "module",
  "scripts": {
    "build": "vite build && cp index.html icon.svg dist/ && touch dist/.gitkeep",
    "dev": "vite",
    "test": "node --test src/*.test.mjs",
    "test:workbench": "node --test src/workbench.test.mjs",
    "test:preview-state": "node --test src/previewState.test.mjs",
    "test:preview-console": "node --test src/previewConsole.test.mjs",
    "test:create-readiness": "node --test src/createReadiness.test.mjs",
    "test:llm-settings": "node --test src/llmSettingsValidation.test.mjs",
    "test:assistant-actions": "node --test src/assistantActionFeed.test.mjs src/assistantActionLog.test.mjs",
    "test:assistant-plan": "node --test src/assistantPlan.test.mjs",
    "test:assistant-plan-popover": "node --test src/assistantPlanPopover.test.mjs",
    "test:assistant-progress": "node --test src/assistantProgress.test.mjs",
    "test:assistant-trace": "node --test src/assistantTrace.test.mjs",
    "test:approval-mode": "node --test src/approvalModePicker.test.mjs",
    "test:response-mode": "node --test src/responseModePicker.test.mjs",
    "test:conversation-resilience": "node --test src/conversationResilience.test.mjs",
    "test:activity": "node --test src/activity.test.mjs",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "lucide-vue-next": "^1.0.0",
    "markdown-it": "^14.2.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@types/markdown-it": "^14.1.2",
    "@vitejs/plugin-vue": "^5.2.3",
    "tailwindcss": "^4.3.1",
    "typescript": "~5.7.0",
    "vite": "^6.3.0",
    "vue-tsc": "^2.2.0"
  }
}
